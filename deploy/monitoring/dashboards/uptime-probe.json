{
  "title": "Uptime Probe",
  "uid": "uptime-probe",
  "schemaVersion": 39,
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "panels": [
    {
      "type": "stat",
      "title": "Targets up",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "targets": [{ "expr": "sum(max by (target) (probe_target_up))", "refId": "A" }]
    },
    {
      "type": "stat",
      "title": "Targets down",
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "targets": [{ "expr": "count(max by (target) (probe_target_up) == 0) or vector(0)", "refId": "A" }]
    },
    {
      "type": "table",
      "title": "Availability (24h)",
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 0 },
      "targets": [{ "expr": "avg_over_time(max by (target) (probe_target_up)[24h:1m]) * 100", "refId": "A", "format": "table", "instant": true }]
    },
    {
      "type": "timeseries",
      "title": "p95 latency by target",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 10 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (target, le) (rate(probe_target_latency_seconds_bucket[5m])))", "legendFormat": "{{target}}", "refId": "A" }]
    }
  ]
}
